# ===== AquaDetective 后端环境变量（复制为 .env 后按需修改）=====
# LLM 配置（OpenAI 兼容接口；不配置时自动降级为模板推理，演示也不会挂）
AQ_LLM_BASE_URL=
AQ_LLM_API_KEY=
AQ_LLM_MODEL=gpt-4o-mini
AQ_LLM_TIMEOUT_S=30
# 允许 LLM 不可用/失败时使用模板降级
AQ_ALLOW_MOCK_LLM=true

# ===== 按 Agent 覆盖 LLM（可选；不填则各 Agent 与上面的全局配置一致）=====
# Agent 名：INVESTIGATOR（溯源侦探：解析/假设/校核/结论）、COMPLIANCE（法规）、
#          RESPONDER（处置）、REPORTER（报告）
# 可覆盖项：API_KEY / BASE_URL / MODEL / TIMEOUT_S
# 例：溯源用推理更强的模型，报告用便宜的，法规走本地 Ollama
# AQ_LLM_INVESTIGATOR_MODEL=deepseek-reasoner
# AQ_LLM_REPORTER_MODEL=deepseek-chat
# AQ_LLM_COMPLIANCE_BASE_URL=http://localhost:11434/v1
# AQ_LLM_COMPLIANCE_API_KEY=ollama
# AQ_LLM_COMPLIANCE_MODEL=qwen2.5:7b

# 数据
AQ_DB_PATH=data/aqua.db
AQ_SEED=20250601
AQ_WATERSHED_CONFIG=app/data/watershed_config.json

# 服务
AQ_HOST=127.0.0.1
AQ_PORT=8000

# Monitoring: periodic scans enabled by default; set false for manual-only startup.
AQ_MONITOR_ENABLED=true
AQ_MONITOR_INTERVAL_S=300
AQ_MONITOR_WINDOW_H=24
# cusum | ewma | threesigma | seasonal
AQ_MONITOR_METHOD=cusum
